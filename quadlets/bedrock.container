[Unit]
Description=Servidor Bedrock dedicado

[Container]
Image=docker.io/itzg/minecraft-bedrock-server:latest
ContainerName=bedrock
Environment=EULA=TRUE
Environment=UID=1000
Environment=GID=1000
Environment=SERVER_NAME=Bedrock
Environment=GAMEMODE=survival
Environment=DIFFICULTY=normal
Environment=MAX_PLAYERS=100
Environment=TRANSPORT=nethernet
Environment=SERVER_UDP_PORTS=19132
PublishPort=10.10.10.2:19132:19132/tcp
PublishPort=10.10.10.2:19132:19132/udp
Volume=/srv/minecraft/bedrock:/data
PodmanArgs=--memory=1g
NoNewPrivileges=true
AddCapability=SYS_PTRACE
Environment=ENABLE_WHITELIST=TRUE

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
