# Ejemplo sin secretos. El secreto de reenvío se configura dentro de config/paper-global.yml
[Unit]
Description=Servidor survival (Paper)

[Container]
Image=docker.io/itzg/minecraft-server:java25
ContainerName=survival
Network=mc.network
User=1000
Group=1000
# EULA=TRUE acepta el EULA de Minecraft: leerlo antes de usarlo
Environment=EULA=TRUE
Environment=TYPE=PAPER
# online-mode=false solo es seguro porque este contenedor no publica puertos
Environment=ONLINE_MODE=FALSE
Environment=MEMORY=2G
Volume=/srv/minecraft/survival:/data:U
PodmanArgs=--memory=2560m
DropCapability=ALL
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
