[Unit]
Description=Servidor java (Paper)

[Container]
Image=docker.io/itzg/minecraft-server:java25
ContainerName=java
Network=mc.network
User=1000
Group=1000
Environment=EULA=TRUE
Environment=TYPE=PAPER
Environment=ONLINE_MODE=FALSE
Environment=MEMORY=1G
Volume=/srv/minecraft/java:/data:U
PodmanArgs=--memory=1536m
DropCapability=ALL
NoNewPrivileges=true
Environment=USE_MEOWICE_FLAGS=true
Environment=ENABLE_WHITELIST=TRUE

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
